# LinkedIn Profile Sync Configuration
# Provider Options: proxycurl | scrapin | rapidapi | mock
LINKEDIN_PROVIDER=proxycurl

# API Key for chosen provider:
# - Proxycurl: https://nubela.co/proxycurl/ (free trial available)
# - Scrapin.io: https://scrapin.io/
# - RapidAPI: https://rapidapi.com/rockapis-rockapis-default/api/fresh-linkedin-profile-data
LINKEDIN_API_KEY=your_api_key_here

# Your public LinkedIn profile URL:
LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/fiqi-efendi

# Automatically commit and push updates to Git (true / false)
AUTO_COMMIT=true
